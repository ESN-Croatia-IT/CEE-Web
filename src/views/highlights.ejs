<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Admin panel for the Croatian Erasmus Event. Edit event details, perks, FAQs, and organising committee information." />
    <link href="/output.css" rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap"
      rel="stylesheet" />
    <title>Login</title>
    <link
      id="favicon"
      rel="icon"
      type="image/x-icon"
      href="/images/favicons/CEE_skii.ico"
      sizes="32x32" />
  </head>
  <body class="font-['Montserrat',sans-serif] font-normal md:pt-16 min-h-screen flex flex-col">
    <div id="header-bg"></div>

    <%- include('partials/dropdownlist')%>
    <%- include('partials/header')%>
    
    <main class="grow">
        <h1
            class="text-<%=accentColour%> mb-12 text-center text-3xl font-bold sm:text-4xl">
            CEE Web Editor <i class="fa-solid fa-pencil"></i>
        </h1>

                <form action="/save/highlights" method="post" class="w-11/12 max-w-3xl mx-auto mb-6 flex flex-col space-y-4 border-<%=accentColour%> rounded-lg border-2 p-6 shadow-lg">
            <h2 class="text-<%=accentColour%> text-2xl font-bold mb-4 mt-6 inline">Highlights</h2>
            
            <% for(let i = 0; i < perks.length; i++) { %>
                <div class="border-0 p-4 rounded-lg border-<%=accentColour%> mb-4">
                    
                    <button type="button" class="cursor-pointer mb-2 text-<%=accentColour%>-darkened font-bold ml-2">
                        <i class="fa-solid fa-caret-up"></i>
                    </button>
                    <button type="button" class="cursor-pointer mb-2 text-<%=accentColour%>-darkened font-bold ml-2">
                        <i class="fa-solid fa-caret-down"></i>
                    </button>
                    <button type="button" class="cursor-pointer mb-2 text-<%=accentColour%>-darkened font-bold ml-2">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                    
                    <div class="flex flex-row">
                        <label class="font-bold text-<%=accentColour%> mb-2 mr-2" for="perk-name-<%=i%>">Name:</label>
                        <input
                        class="border-<%=accentColour%> rounded-lg border-dashed border-t p-2 mb-2 w-full font-bold"
                        type="text"
                        id="perk-name-<%=i%>"
                        name="perk-name-<%=i%>"
                        value="<%=perks[i].title%>"
                        required />
                    </div>
                    <div class="flex flex-row">
                        <label class="font-bold text-<%=accentColour%> mb-2 mr-2" for="perk-description-<%=i%>">Description:</label>
                        <textarea
                        class="border-<%=accentColour%> rounded-lg border-dashed border-b p-2 mb-2 w-full"
                        rows="5"
                        id="perk-description-<%=i%>"
                        name="perk-description-<%=i%>"
                        required><%=perks[i].description%></textarea>
                    </div>
                    <label class="font-bold text-<%=accentColour%> mb-2 mr-2" for="perk-image-<%=i%>">Photo:</label>
                    <input type="file" name="perk-image-<%=i%>" id="perk-image-<%=i%>" accept="image/*" class="border-<%=accentColour%> rounded-lg border-dashed border-2 p-2 mb-2 w-full" />
                    <img src="<%=perks[i].image%>" alt="Perk Photo" class="mb-2 w-24 object-contain border-<%=accentColour%> rounded-lg border-2 p-2" />
                </div>
                
                
                
                <% } %>
                <button type="button" class="mx-auto scale-200 cursor-pointer text-<%=accentColour%>-darkened font-bold">
                    <i class="fa-solid fa-circle-plus"></i>
                </button>
                    
            <button type="submit"
                class="w-24 mx-auto mt-4 rounded hover:bg-<%=accentColour%>-darkened px-4 py-2 font-bold hover:text-white bg-<%=accentColour%> text-white cursor-pointer">
                Save
            </button>
        </form>


    </main>


    <%- include('partials/footer')%>
  </body>
</html>



