<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<nav class="hidden md:flex bg-gray-700 fixed top-0 left-0 right-0 z-40 px-6 py-4 justify-between items-center text-white">
    <a href="/editor" class="text-xl font-bold hover:underline">CEE Event Manager</a>
    <div class="flex items-center gap-6 font-bold text-lg">
        <a href="details" class="hover:underline" id="details-link">Details</a>
        <a href="appearance" class="hover:underline" id="appearance-link">Appearance</a>
        <a href="benefits" class="hover:underline" id="benefits-link">Benefits</a>
        <a href="oc" class="hover:underline" id="oc-link">OC</a>
        <a href="faq" class="hover:underline" id="faq-link">FAQ</a>
        <a href="/event/<%=eventId%>" class="flex items-center gap-1 px-3 py-1 rounded border border-white/40 hover:bg-white/10 transition-colors">
            <i class="fa-solid fa-eye text-sm"></i> View
        </a>
        <form action="/logout" method="POST">
            <button type="submit" class="cursor-pointer hover:underline">Logout</button>
        </form>
    </div>
</nav>

<div id="menu" class="fixed top-4 right-4 z-50 cursor-pointer md:hidden" onclick="toggleDropdown()">
    <i class="fas fa-bars text-gray-700 text-[32px]"></i>
</div>

<div id="dropdown"
    class="bg-gray-700 fixed top-[-100vh] right-0 left-0 z-40 flex w-full flex-col items-center space-y-6 px-5 pt-10 pb-5 text-center text-xl font-bold text-white transition-all duration-700">
    <a href="details" class="hover:underline" id="details-link-mobile">Details</a>
    <a href="appearance" class="hover:underline" id="appearance-link-mobile">Appearance</a>
    <a href="benefits" class="hover:underline" id="benefits-link-mobile">Benefits</a>
    <a href="oc" class="hover:underline" id="oc-link-mobile">OC</a>
    <a href="faq" class="hover:underline" id="faq-link-mobile">FAQ</a>
    <a href="/event/<%=eventId%>" class="flex items-center gap-1 px-3 py-1 rounded border border-white/40 hover:bg-white/10 transition-colors">
        <i class="fa-solid fa-eye text-sm"></i> View
    </a>
    <form action="/logout" method="POST">
        <button type="submit" class="cursor-pointer hover:underline">Logout</button>
    </form>
</div>

<script>
    function toggleDropdown() {
        const dropdown = document.getElementById('dropdown');
        const icon = document.querySelector('#menu i');
        const open = !dropdown.classList.contains('top-[-100vh]');
        dropdown.classList.toggle('top-[-100vh]', open);
        dropdown.classList.toggle('top-0', !open);
        icon.classList.toggle('text-white', !open);
        icon.classList.toggle('text-gray-700', open);
    }

    function setActiveLink() {
        const page = window.location.pathname.split('/').pop() || '';
        const map = {
            details:    ['details-link',    'details-link-mobile'],
            appearance: ['appearance-link', 'appearance-link-mobile'],
            benefits:   ['benefits-link',   'benefits-link-mobile'],
            oc:         ['oc-link',         'oc-link-mobile'],
            faq:        ['faq-link',        'faq-link-mobile'],
        };
        for (const [key, ids] of Object.entries(map)) {
            if (page === key || page.includes(key)) {
                ids.forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.classList.add('underline');
                });
            }
        }
    }

    document.addEventListener('DOMContentLoaded', setActiveLink);
</script>
